# heavy solver outputs: regenerated by re-running the decks (deterministic);
# the measured numbers are in results.jsonl / sensitivity.csv / validity_*.json
__pycache__/
runs/*/*/output/*.vtk
runs/*/*/output/*_nodes.csv
runs/*/*/output/mesh.json
runs/*/*/output/config.json
runs/*/*/output/tool_forces.csv
runs/*/*/output/step_1_form_elements.csv
runs/*/*/output/step_2_unload_elements.csv
runs/*/*/surfaces.npz
