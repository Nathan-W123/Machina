// Single-point incremental forming of a cone, explicit forming (docs/forming.md,
// "Explicit forming"): configs/forming/spif_cone_60.json with its `form` and
// `retract` steps integrated by central differences (`form_explicit`) - the
// tool travelling along its path at 1 m/s, the mass scaled selectively to a
// 1 us time step and raised where the thinning wall's elements would lower it
// (dynamic scaling) - and the springback released implicitly onto the same
// 3-2-1 supports. The same 60 x 60 x 1 mm blank (60 x 60 x 2 Hex8), 5 mm tool and
// ten 1 mm contours to 10 mm depth (spif_cone_60_toolpath.csv).
{
  "name": "spif_cone_60_explicit",
  "description": "SPIF cone, explicit forming: 60 x 60 x 1 mm blank (60 x 60 x 2 Hex8), 5 mm tool, 10 contours to 10 mm, retract, unclamp",
  "mesh": { "type": "structured_hex", "nx": 60, "ny": 60, "nz": 2,
            "lx": 0.06, "ly": 0.06, "lz": 0.001, "x0": -0.03, "y0": -0.03, "z0": -0.001 },
  "material": { "name": "AA1050-like", "youngs_modulus": 70.0e9, "poisson_ratio": 0.33,
                "density": 2700.0,
                "plasticity": { "yield_stress": 100.0e6, "hardening_modulus": 300.0e6 } },
  "forming": {
    "kinematics": "finite",
    "tools": [
      { "name": "tool", "shape": "sphere", "radius": 0.005,
        "surface": { "box": { "zmin": 0.0 } },
        "friction": 0.05, "penalty": 10.0,
        "trajectory": { "file": "spif_cone_60_toolpath.csv" } }
    ],
    "steps": [
      { "name": "form", "type": "form_explicit", "tools": ["tool"], "time": [0.0, 11.9],
        "explicit": { "tool_speed": 1.0,
                      "mass_scaling": { "mode": "selective", "target_time_step": 1.0e-6,
                                        "max_added_mass_fraction": 1000.0, "dynamic": true },
                      "history_every": 200 },
        "boundary_conditions": [
          { "name": "frame", "fix": ["x", "y", "z"], "mode": "hold",
            "region": { "any_of": [ { "box": { "xmax": -0.0225 } }, { "box": { "xmin": 0.0225 } },
                                    { "box": { "ymax": -0.0225 } }, { "box": { "ymin": 0.0225 } } ] } } ] },
      { "name": "retract", "type": "form_explicit", "tools": ["tool"], "time": [11.9, 12.0],
        "explicit": { "tool_speed": 1.0,
                      "mass_scaling": { "mode": "selective", "target_time_step": 1.0e-6,
                                        "max_added_mass_fraction": 1000.0, "dynamic": true },
                      "history_every": 200 },
        "boundary_conditions": [
          { "name": "frame", "fix": ["x", "y", "z"], "mode": "hold",
            "region": { "any_of": [ { "box": { "xmax": -0.0225 } }, { "box": { "xmin": 0.0225 } },
                                    { "box": { "ymax": -0.0225 } }, { "box": { "ymin": 0.0225 } } ] } } ] },
      { "name": "unclamp", "type": "release", "increments": 10,
        "boundary_conditions": [
          { "name": "A", "fix": ["x", "y", "z"], "region": { "nearest_node": [-0.03, -0.03, 0.0] } },
          { "name": "B", "fix": ["y", "z"], "region": { "nearest_node": [0.03, -0.03, 0.0] } },
          { "name": "C", "fix": ["z"], "region": { "nearest_node": [-0.03, 0.03, 0.0] } } ] }
    ],
    "newton": { "max_iterations": 30, "residual_tolerance": 1.0e-6, "line_search": true,
                "max_cuts": 10 },
    "output": { "vtk": true, "snapshots": "steps" }
  }
}
