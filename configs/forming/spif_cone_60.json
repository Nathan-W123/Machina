// Single-point incremental forming of a cone, the cost case of
// docs/forming.md: a 60 mm x 60 mm x 1 mm aluminium blank (Hex8, 60 x 60 x 2,
// 1 mm in the plane, mean dilatation) clamped on a 7.5 mm frame, formed by a
// 5 mm radius sphere along ten contour levels with a 1 mm step-down to
// 10 mm depth - the tool's centre on circles of 14 mm down to 5 mm radius
// (a 45 degree wall, about 30 mm opening) - then retracted, and the part
// unclamped onto 3-2-1 supports at three corners. spif_cone_60_toolpath.csv
// was written by python/scripts/make_forming_toolpath.py --tool-radius 0.005
// --radius 0.014 --dr 0.001 --dz 0.001 --levels 10 --segments 48.
{
  "name": "spif_cone_60",
  "description": "SPIF cone: 60 x 60 x 1 mm blank (60 x 60 x 2 Hex8), 5 mm tool, 10 contours to 10 mm, retract, unclamp",
  "mesh": { "type": "structured_hex", "nx": 60, "ny": 60, "nz": 2,
            "lx": 0.06, "ly": 0.06, "lz": 0.001, "x0": -0.03, "y0": -0.03, "z0": -0.001 },
  "material": { "name": "AA1050-like", "youngs_modulus": 70.0e9, "poisson_ratio": 0.33,
                "density": 2700.0,
                "plasticity": { "yield_stress": 100.0e6, "hardening_modulus": 300.0e6 } },
  "forming": {
    "kinematics": "finite",
    "tools": [
      { "name": "tool", "shape": "sphere", "radius": 0.005,
        "surface": { "box": { "zmin": 0.0 } },
        "friction": 0.05, "penalty": 10.0,
        "trajectory": { "file": "spif_cone_60_toolpath.csv" } }
    ],
    "steps": [
      { "name": "form", "type": "form", "tools": ["tool"], "time": [0.0, 11.9],
        "max_tool_travel": 5.0e-4,
        "boundary_conditions": [
          { "name": "frame", "fix": ["x", "y", "z"], "mode": "hold",
            "region": { "any_of": [ { "box": { "xmax": -0.0225 } }, { "box": { "xmin": 0.0225 } },
                                    { "box": { "ymax": -0.0225 } }, { "box": { "ymin": 0.0225 } } ] } } ] },
      { "name": "retract", "type": "form", "tools": ["tool"], "time": [11.9, 12.0],
        "max_tool_travel": 5.0e-4,
        "boundary_conditions": [
          { "name": "frame", "fix": ["x", "y", "z"], "mode": "hold",
            "region": { "any_of": [ { "box": { "xmax": -0.0225 } }, { "box": { "xmin": 0.0225 } },
                                    { "box": { "ymax": -0.0225 } }, { "box": { "ymin": 0.0225 } } ] } } ] },
      { "name": "unclamp", "type": "release", "increments": 10,
        "boundary_conditions": [
          { "name": "A", "fix": ["x", "y", "z"], "region": { "nearest_node": [-0.03, -0.03, 0.0] } },
          { "name": "B", "fix": ["y", "z"], "region": { "nearest_node": [0.03, -0.03, 0.0] } },
          { "name": "C", "fix": ["z"], "region": { "nearest_node": [-0.03, 0.03, 0.0] } } ] }
    ],
    "newton": { "max_iterations": 30, "residual_tolerance": 1.0e-6, "line_search": true,
                "max_cuts": 10 },
    "output": { "vtk": true, "snapshots": "steps" }
  }
}
