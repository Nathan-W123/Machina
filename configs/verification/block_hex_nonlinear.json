{
  // ---------------------------------------------------------------------------
  // Cross-validation of the geometrically non-linear analysis on Hex8 (C3D8)
  // elements: a soft block 0.4 m x 0.1 m x 0.1 m (E = 50 MPa, nu = 0.3,
  // rho = 1100 kg/m^3) clamped at x = 0, two ways:
  //   * a pressure of 0.2 MPa on its top face that follows the face as the
  //     block bends through about 0.17 m, with its self-weight;
  //   * a rotation of 300 rad/s about the z axis through the middle of the
  //     root, whose centrifugal load acts at the deformed position (the block
  //     stretches by about 10 %).
  // CalculiX solves the same discrete problem with *STEP, NLGEOM (a follower
  // *DLOAD pressure, CENTRIF) - python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "block_hex_nonlinear",
  "description": "Soft block under a follower pressure and a rotation, Hex8 (C3D8) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_hex", "nx": 16, "ny": 4, "nz": 4, "lx": 0.4, "ly": 0.1, "lz": 0.1 },

  "material": { "name": "elastomer-like", "youngs_modulus": 5.0e7, "poisson_ratio": 0.3, "density": 1100.0 },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    {
      "name": "top_pressure",
      "gravity": [0.0, 0.0, -9.81],
      "pressures": [ { "name": "top", "pressure": 2.0e5, "region": { "box": { "zmin": 0.1 } } } ]
    },
    {
      "name": "spin",
      "centrifugal": { "angular_velocity": 300.0, "axis": [0.0, 0.0, 1.0], "point": [0.0, 0.05, 0.0] }
    }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "material_model": "saint_venant_kirchhoff",
    "steps": 10,
    "residual_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_z", "component": "z", "region": { "box": { "xmin": 0.4 } } },
      { "name": "tip_x", "component": "x", "region": { "box": { "xmin": 0.4 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
