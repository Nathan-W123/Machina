{
  // ---------------------------------------------------------------------------
  // Cross-validation of a harmonic response driven by prescribed motion, with
  // lumped mass, on Hex8: an aluminium block 0.3 m x 0.1 m x 0.1 m standing
  // on its base, the base shaken along x (1e-4 m) and z (5e-5 m), with
  // structural damping eta = 0.01, from 50 Hz to 8 kHz (80 frequencies,
  // linear; its first six modes lie between 896 Hz and 4.3 kHz), the fields
  // at 2 and 5 kHz. Compared with a direct complex solve
  // per frequency in scikit-fem (the same lumped mass) -
  // python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "frequency_response_block_hex",
  "description": "Hex8 block on a shaken base, lumped mass, harmonic response (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, s)",

  "mesh": { "type": "structured_hex", "nx": 3, "ny": 3, "nz": 9, "lx": 0.1, "ly": 0.1, "lz": 0.3 },

  "material": { "name": "aluminium", "youngs_modulus": 70.0e9, "poisson_ratio": 0.33, "density": 2700.0 },

  "boundary_conditions": [
    { "name": "shaken_base", "fix": ["x", "y", "z"], "value": [1.0e-4, 0.0, 5.0e-5],
      "region": { "box": { "zmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "base", "prescribed_displacement_only": true }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "frequency_response": {
    "enabled": true,
    "frequencies": { "start": 50.0, "end": 8000.0, "count": 80, "spacing": "linear" },
    "mass": "lumped",
    "damping": { "structural": 0.01 },
    "snapshot_frequencies": [2000.0, 5000.0],
    "monitors": [
      { "name": "top_ux", "component": "x", "region": { "box": { "zmin": 0.3 } } },
      { "name": "top_uz", "component": "z", "region": { "box": { "zmin": 0.3 } } },
      { "name": "base_force_x", "component": "x", "quantity": "reaction", "region": { "box": { "zmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
