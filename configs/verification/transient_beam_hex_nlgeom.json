{
  // ---------------------------------------------------------------------------
  // Cross-validation of the geometrically non-linear transient (total
  // Lagrangian, Saint Venant-Kirchhoff) on Hex8 (C3D8): a slender elastic
  // strip 1 m x 0.05 m x 0.02 m (E = 1 GPa), clamped, its tip load of 200 N
  // in y (a static deflection of 0.251 m, which the small-deflection answer
  // overstates by 5 %) ramped up as sin^2 over 0.1 s and held, undamped, 150
  // steps of 2 ms with the trapezoidal rule: the tip swings down to 0.357 m
  // and in by 0.079 m (measured). Compared with
  // CalculiX's *DYNAMIC, DIRECT under NLGEOM and with an independent total
  // Lagrangian implementation integrated by HHT-alpha in scikit-fem -
  // python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "transient_beam_hex_nlgeom",
  "description": "Slender Hex8 strip swinging through large deflection, Saint Venant-Kirchhoff, trapezoidal rule (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, s)",

  "mesh": { "type": "structured_hex", "nx": 30, "ny": 2, "nz": 1, "lx": 1.0, "ly": 0.05, "lz": 0.02 },

  "material": { "name": "polymer", "youngs_modulus": 1.0e9, "poisson_ratio": 0.3, "density": 1200.0 },

  "boundary_conditions": [
    { "name": "clamped", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "tip", "point_loads": [
        { "name": "tip_face", "force": [0.0, -200.0, 0.0], "distribution": "total",
          "region": { "box": { "xmin": 1.0 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "transient": {
    "enabled": true,
    "time_step": 2.0e-3,
    "end_time": 0.3,
    "alpha": 0.0,
    "mass": "consistent",
    "amplitude": { "type": "table", "times": [0, 0.002, 0.0040000000000000001, 0.0060000000000000001, 0.0080000000000000002, 0.01, 0.012, 0.014, 0.016, 0.018000000000000002, 0.02, 0.021999999999999999, 0.024, 0.026000000000000002, 0.028000000000000001, 0.029999999999999999, 0.032000000000000001, 0.034000000000000002, 0.036000000000000004, 0.037999999999999999, 0.040000000000000001, 0.042000000000000003, 0.043999999999999997, 0.045999999999999999, 0.048000000000000001, 0.050000000000000003, 0.052000000000000005, 0.053999999999999999, 0.056000000000000001, 0.058000000000000003, 0.059999999999999998, 0.062, 0.064000000000000001, 0.066000000000000003, 0.068000000000000005, 0.070000000000000007, 0.072000000000000008, 0.073999999999999996, 0.075999999999999998, 0.078, 0.080000000000000002, 0.082000000000000003, 0.084000000000000005, 0.086000000000000007, 0.087999999999999995, 0.089999999999999997, 0.091999999999999998, 0.094, 0.096000000000000002, 0.098000000000000004, 0.10000000000000001],
                   "values": [0, 0.000986635785864219, 0.0039426493427610846, 0.0088563746356556585, 0.015708419435684445, 0.024471741852423214, 0.035111757055874285, 0.047586473766990219, 0.061846659978068208, 0.077836037248992476, 0.095491502812526274, 0.11474337861210533, 0.1355156862892942, 0.15772644703565566, 0.1812880051256551, 0.2061073738537634, 0.23208660251050173, 0.25912316294914239, 0.28711035421746373, 0.31593772365766098, 0.34549150281252627, 0.37565505641757257, 0.40630934270713759, 0.43733338321784782, 0.46860474023534321, 0.49999999999999989, 0.53139525976465674, 0.56266661678215202, 0.59369065729286219, 0.62434494358242743, 0.65450849718747361, 0.68406227634233885, 0.71288964578253633, 0.7408768370508575, 0.76791339748949827, 0.79389262614623646, 0.81871199487434498, 0.84227355296434414, 0.86448431371070567, 0.88525662138789463, 0.90450849718747361, 0.92216396275100754, 0.93815334002193174, 0.95241352623300957, 0.96488824294412556, 0.97552825814757682, 0.98429158056431565, 0.99114362536434431, 0.99605735065723888, 0.99901336421413589, 1] },
    "snapshot_every": 15,
    "nonlinear": true,
    "kinematics": "finite",
    "residual_tolerance": 1.0e-10,
    "displacement_tolerance": 1.0e-10,
    "monitors": [
      { "name": "tip_ux", "component": "x", "region": { "box": { "xmin": 1.0 } } },
      { "name": "tip_uy", "component": "y", "region": { "box": { "xmin": 1.0 } } },
      { "name": "root_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
