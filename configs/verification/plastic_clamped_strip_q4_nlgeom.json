{
  // ---------------------------------------------------------------------------
  // Cross-validation of finite-kinematics plasticity with mean dilatation
  // (E-bar) in plane strain on Q4 (CPE4) elements: the clamped beam of
  // plastic_clamped_beam_hex_nlgeom as a strip 1 m x 0.05 m, 0.05 m thick
  // (E = 200 GPa, nu = 0.3, yield stress 250 MPa; isotropic hardening 1 GPa
  // plus a Voce saturation of 60 MPa at rate 30, Prager kinematic hardening
  // 2 GPa), its mid-span section driven 20 mm down into membrane action and
  // back up to zero (load path 1 -> 0). In plane strain the averaged
  // dilatation gives the thickness a Green strain of its own, E_33 =
  // (mean(tr E) - tr E) / 3. Its judged comparison is with an independent
  // finite-kinematics J2 implementation in scikit-fem; CalculiX gets no
  // plastic deck (its HARDENING=KINEMATIC does not reproduce Prager's rule) -
  // python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "plastic_clamped_strip_q4_nlgeom",
  "description": "Clamped plane-strain strip driven past yield into membrane action and back, finite kinematics, combined hardening, Q4 with E-bar (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_quad", "nx": 40, "ny": 4, "lx": 1.0, "ly": 0.05 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "plasticity": {
      "yield_stress": 250.0e6,
      "hardening_modulus": 1.0e9,
      "saturation_stress": 60.0e6,
      "saturation_rate": 30.0,
      "kinematic_hardening_modulus": 2.0e9
    }
  },

  "model": { "thickness": 0.05, "stress_state": "plane_strain" },

  "boundary_conditions": [
    { "name": "clamped_left", "fix": ["x", "y"], "region": { "box": { "xmax": 0.0 } } },
    { "name": "clamped_right", "fix": ["x", "y"], "region": { "box": { "xmin": 1.0 } } },
    { "name": "driven_mid_span", "fix": ["y"], "value": [0.0, -2.0e-2],
      "region": { "box": { "xmin": 0.5, "xmax": 0.5 } } }
  ],

  "load_cases": [
    { "name": "drive", "prescribed_displacement_only": true }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "finite",
    "steps": 10,
    "load_path": [1.0, 0.0],
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "mid_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmin": 0.5, "xmax": 0.5 } } },
      { "name": "end_force_x", "component": "x", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
