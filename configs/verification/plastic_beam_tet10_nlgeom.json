{
  // ---------------------------------------------------------------------------
  // Cross-validation of finite-kinematics plasticity on Tet10 (C3D10)
  // elements: a steel cantilever 1 m x 0.02 m x 0.02 m (E = 200 GPa,
  // nu = 0.3, yield stress 250 MPa, linear isotropic hardening 2 GPa) under a
  // dead tip force of 520 N, 1.56 times its elastic limit at small deflection
  // (just beyond the plastic collapse of beam theory, which the hardening
  // and the shortening lever arm of the deflected beam carry): a plastic zone
  // at the root and a tip deflection of about a tenth of the span. (L/h = 50:
  // at 100 the linear solve's round-off in the slender beam reaches 3e-7.)
  // SparLab's J2 return in the Green-Lagrange strain (small strain, large
  // rotation) is judged against an independent implementation of the same
  // model in scikit-fem; against CalculiX's finite-strain J2 under *STEP,
  // NLGEOM - a different model that agrees to the order of the strain (about
  // 0.3 %) - the comparison is informational. (Quadratic tetrahedra: a fully
  // integrated Hex8 two cells deep locks in bending and would stay elastic.)
  // ---------------------------------------------------------------------------
  "name": "plastic_beam_tet10_nlgeom",
  "description": "Slender steel cantilever bent past yield with large deflection, Tet10 (C3D10) elements (validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_tet", "nx": 40, "ny": 2, "nz": 2, "lx": 1.0, "ly": 0.02, "lz": 0.02, "order": 2 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "plasticity": { "yield_stress": 250.0e6, "hardening_modulus": 2.0e9 }
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "tip", "point_loads": [ { "name": "tip", "force": [0.0, -520.0, 0.0], "region": { "box": { "xmin": 1.0 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "finite",
    "mean_dilatation": "none",
    "steps": 10,
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_y", "component": "y", "region": { "box": { "xmin": 1.0 } } },
      { "name": "tip_x", "component": "x", "region": { "box": { "xmin": 1.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
