{
  // ---------------------------------------------------------------------------
  // Cross-validation of the linear transient (HHT-alpha, Rayleigh damping) on
  // Hex8 (C3D8): a steel cantilever 1 m x 0.1 m x 0.1 m (first bending
  // frequency 84.9 Hz), clamped, its tip load (200, -1000, 400) N ramped up
  // as sin^2 over 4 ms and then held, 300 steps of 0.1 ms with alpha =
  // -0.05, C = 20 M + 1e-5 K. Compared step by
  // step (the monitors) and field by field (every 30th step and the final
  // state) with CalculiX's *DYNAMIC, DIRECT, ALPHA=-0.05 and with an
  // independent HHT-alpha integration in scikit-fem -
  // python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "transient_cantilever_hex",
  "description": "Hex8 cantilever under a ramped 3-D tip load, HHT-alpha with Rayleigh damping (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, s)",

  "mesh": { "type": "structured_hex", "nx": 24, "ny": 3, "nz": 3, "lx": 1.0, "ly": 0.1, "lz": 0.1 },

  "material": { "name": "steel", "youngs_modulus": 200.0e9, "poisson_ratio": 0.3, "density": 7850.0 },

  "boundary_conditions": [
    { "name": "clamped", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "tip", "point_loads": [
        { "name": "tip_face", "force": [200.0, -1000.0, 400.0], "distribution": "total",
          "region": { "box": { "xmin": 1.0 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "transient": {
    "enabled": true,
    "time_step": 1.0e-4,
    "end_time": 3.0e-2,
    "alpha": -0.05,
    "mass": "consistent",
    "damping": { "mass": 20.0, "stiffness": 1.0e-5 },
    "amplitude": { "type": "table", "times": [0, 0.0001, 0.00020000000000000001, 0.00030000000000000003, 0.00040000000000000002, 0.00050000000000000001, 0.00060000000000000006, 0.00069999999999999999, 0.00080000000000000004, 0.00090000000000000008, 0.001, 0.0011000000000000001, 0.0012000000000000001, 0.0013000000000000002, 0.0014, 0.0015, 0.0016000000000000001, 0.0017000000000000001, 0.0018000000000000002, 0.0019, 0.002, 0.0021000000000000003, 0.0022000000000000001, 0.0023, 0.0024000000000000002, 0.0025000000000000001, 0.0026000000000000003, 0.0027000000000000001, 0.0028, 0.0029000000000000002, 0.0030000000000000001, 0.0031000000000000003, 0.0032000000000000002, 0.0033, 0.0034000000000000002, 0.0035000000000000001, 0.0036000000000000003, 0.0037000000000000002, 0.0038, 0.0039000000000000003, 0.0040000000000000001],
                   "values": [0, 0.001541333133436012, 0.0061558297024311365, 0.013815039801161702, 0.024471741852423214, 0.038060233744356617, 0.054496737905816071, 0.073679917822953897, 0.095491502812526274, 0.11979701719998456, 0.14644660940672624, 0.17527597583490817, 0.20610737385376346, 0.23875071764202552, 0.27300475013022651, 0.30865828381745508, 0.34549150281252627, 0.3832773180720474, 0.42178276747988469, 0.46077045213607742, 0.49999999999999989, 0.53922954786392252, 0.57821723252011548, 0.61672268192795276, 0.65450849718747373, 0.69134171618254492, 0.72699524986977337, 0.7612492823579744, 0.79389262614623646, 0.82472402416509172, 0.85355339059327373, 0.88020298280001552, 0.90450849718747361, 0.92632008217704609, 0.945503262094184, 0.96193976625564337, 0.97552825814757682, 0.98618496019883828, 0.99384417029756889, 0.99845866686656393, 1] },
    "snapshot_every": 30,
    "monitors": [
      { "name": "tip_uy", "component": "y", "region": { "box": { "xmin": 1.0 } } },
      { "name": "tip_uz", "component": "z", "region": { "box": { "xmin": 1.0 } } },
      { "name": "tip_vy", "component": "y", "quantity": "velocity", "region": { "box": { "xmin": 1.0 } } },
      { "name": "root_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
