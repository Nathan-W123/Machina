{
  // ---------------------------------------------------------------------------
  // Cross-validation of the linear transient on quadratic tetrahedra (C3D10):
  // the steel cantilever 1 m x 0.1 m x 0.1 m as 20 x 2 x 2 cubes of six Tet10
  // each, clamped, undamped, its tip driven by a harmonic force of 500 N in y
  // at 60 Hz (sin, from rest) - below its first bending frequency, 81.5 Hz -
  // for 400 steps of 0.1 ms with the trapezoidal rule (alpha = 0). Compared
  // with CalculiX's *DYNAMIC, DIRECT, ALPHA=0 and with an independent
  // HHT-alpha integration in scikit-fem - python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "transient_column_tet10",
  "description": "Tet10 cantilever driven harmonically from rest, trapezoidal rule (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, s)",

  "mesh": { "type": "structured_tet", "nx": 20, "ny": 2, "nz": 2, "lx": 1.0, "ly": 0.1, "lz": 0.1, "order": 2 },

  "material": { "name": "steel", "youngs_modulus": 200.0e9, "poisson_ratio": 0.3, "density": 7850.0 },

  "boundary_conditions": [
    { "name": "clamped", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "shake", "point_loads": [
        { "name": "tip_face", "force": [0.0, 500.0, 0.0], "distribution": "total",
          "region": { "box": { "xmin": 1.0 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "transient": {
    "enabled": true,
    "time_step": 1.0e-4,
    "end_time": 4.0e-2,
    "alpha": 0.0,
    "mass": "consistent",
    "amplitude": { "type": "harmonic", "frequency": 60.0 },
    "snapshot_every": 40,
    "monitors": [
      { "name": "tip_uy", "component": "y", "region": { "box": { "xmin": 1.0 } } },
      { "name": "tip_ay", "component": "y", "quantity": "acceleration", "region": { "box": { "xmin": 1.0 } } },
      { "name": "root_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
