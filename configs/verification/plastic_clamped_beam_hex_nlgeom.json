{
  // ---------------------------------------------------------------------------
  // Cross-validation of finite-kinematics plasticity with mean dilatation
  // (E-bar) and combined hardening on Hex8 elements: a steel beam 1 m x
  // 0.05 m x 0.05 m clamped at both ends (E = 200 GPa, nu = 0.3, yield
  // stress 250 MPa; isotropic hardening 1 GPa plus a Voce saturation of
  // 60 MPa at rate 30, Prager kinematic hardening 2 GPa) whose mid-span
  // section is driven 20 mm down - about ten times its first-yield
  // deflection, where the stretching of the deflected beam carries a
  // membrane tension of the order of its bending stresses - and back up to
  // zero (load path 1 -> 0), which leaves it plastically stretched, pushed
  // back into compression and reversed yielding at the hinges. The return is
  // in the Green-Lagrange strain; the Hex8 averages the dilatation (E-bar)
  // by default. Its judged comparison is with an independent finite-
  // kinematics J2 implementation in scikit-fem; CalculiX gets no deck (its
  // HARDENING=KINEMATIC does not reproduce Prager's rule) -
  // python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "plastic_clamped_beam_hex_nlgeom",
  "description": "Clamped steel beam driven past yield into membrane action and back, finite kinematics, combined hardening, Hex8 with E-bar (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_hex", "nx": 40, "ny": 4, "nz": 2, "lx": 1.0, "ly": 0.05, "lz": 0.05 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "plasticity": {
      "yield_stress": 250.0e6,
      "hardening_modulus": 1.0e9,
      "saturation_stress": 60.0e6,
      "saturation_rate": 30.0,
      "kinematic_hardening_modulus": 2.0e9
    }
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_left", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } },
    { "name": "clamped_right", "fix": ["x", "y", "z"], "region": { "box": { "xmin": 1.0 } } },
    { "name": "driven_mid_span", "fix": ["y"], "value": [0.0, -2.0e-2, 0.0],
      "region": { "box": { "xmin": 0.5, "xmax": 0.5 } } }
  ],

  "load_cases": [
    { "name": "drive", "prescribed_displacement_only": true }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "finite",
    "steps": 10,
    "load_path": [1.0, 0.0],
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "mid_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmin": 0.5, "xmax": 0.5 } } },
      { "name": "end_force_x", "component": "x", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
