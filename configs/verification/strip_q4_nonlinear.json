{
  // ---------------------------------------------------------------------------
  // Cross-validation of the geometrically non-linear analysis on plane-strain
  // Q4 (CPE4) elements: an aluminium strip 1 m x 0.05 m (E = 70 GPa, nu = 0.3,
  // 0.02 m thick) clamped at x = 0 under a dead tip load of 4 kN, and under a
  // pressure of 0.4 MPa on its top edge that follows the edge as the strip
  // bends. CalculiX expands its CPE4 cells into a layer of solids held at
  // u_z = 0, which is exact in plane strain; it solves the same discrete
  // problem with *STEP, NLGEOM, and scikit-fem the dead-load case with an
  // independent total Lagrangian implementation.
  // ---------------------------------------------------------------------------
  "name": "strip_q4_nonlinear",
  "description": "Plane-strain strip under a dead tip load and a follower pressure, Q4 (CPE4) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_quad", "nx": 40, "ny": 4, "lx": 1.0, "ly": 0.05 },

  "material": { "name": "Al 6061-T6", "youngs_modulus": 70.0e9, "poisson_ratio": 0.3, "density": 2700.0 },

  "model": { "thickness": 0.02, "stress_state": "plane_strain" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "tip", "point_loads": [ { "name": "tip", "force": [0.0, -4000.0], "region": { "box": { "xmin": 1.0 } } } ] },
    { "name": "top_pressure", "pressures": [ { "name": "top", "pressure": 4.0e5, "region": { "box": { "ymin": 0.05 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "material_model": "saint_venant_kirchhoff",
    "steps": 10,
    "residual_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_y", "component": "y", "region": { "box": { "xmin": 1.0 } } },
      { "name": "tip_x", "component": "x", "region": { "box": { "xmin": 1.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
