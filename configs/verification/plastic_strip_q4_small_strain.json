{
  // ---------------------------------------------------------------------------
  // Cross-validation of small-strain J2 plasticity on plane-strain Q4 (CPE4)
  // elements: a steel strip 1 m x 0.05 m (0.02 m thick; E = 200 GPa,
  // nu = 0.3, yield stress 250 MPa, linear isotropic hardening 1 GPa) clamped
  // at x = 0 under a tip force of 3.6 kN, 1.5 times its elastic limit in
  // plane strain by beam theory (the fully integrated Q4 is stiffer in
  // bending and yields less). CalculiX expands its CPE4 cells into a layer of solids held
  // at u_z = 0, which is exact in plane strain, and solves the same discrete
  // problem with *PLASTIC; scikit-fem with an independent J2 implementation.
  // No mean dilatation (CalculiX's CPE4 has none).
  // ---------------------------------------------------------------------------
  "name": "plastic_strip_q4_small_strain",
  "description": "Plane-strain steel strip loaded into the plastic range, Q4 (CPE4) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_quad", "nx": 40, "ny": 6, "lx": 1.0, "ly": 0.05 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "plasticity": { "yield_stress": 250.0e6, "hardening_modulus": 1.0e9 }
  },

  "model": { "thickness": 0.02, "stress_state": "plane_strain" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "tip", "point_loads": [ { "name": "tip", "force": [0.0, -3600.0], "region": { "box": { "xmin": 1.0 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "small_strain",
    "mean_dilatation": "none",
    "steps": 10,
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_y", "component": "y", "region": { "box": { "xmin": 1.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
