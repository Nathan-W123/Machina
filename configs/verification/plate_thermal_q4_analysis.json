{
  // ---------------------------------------------------------------------------
  // Cross-validation of the thermal loads on plane-strain Q4 (CPE4) elements: a 0.2 m x 0.1 m
  // plate of steel (x < 0.1 m) and aluminium (x > 0.1 m), clamped at x = 0,
  // under a conducted temperature field, a uniform temperature and a hot end
  // with self-weight. The CalculiX export writes the two materials with
  // *EXPANSION and the nodal *TEMPERATURE of each case, and the conduction
  // problem as its own *HEAT TRANSFER deck, so CalculiX computes both the
  // temperature and the thermal load itself; python/scripts/cross_validate.py
  // compares the temperatures and the displacements.
  // ---------------------------------------------------------------------------
  "name": "plate_thermal_q4_analysis",
  "description": "Conduction and thermal stress in a two-material plate on plane-strain Q4 (CPE4) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, K, W)",

  "mesh": { "type": "structured_quad", "nx": 40, "ny": 20, "lx": 0.2, "ly": 0.1 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "thermal_expansion": 1.2e-5,
    "reference_temperature": 293.15,
    "conductivity": 45.0
  },

  "material_regions": [
    {
      "name": "aluminium_half",
      "region": { "box": { "xmin": 0.1 } },
      "material": {
        "name": "aluminium",
        "youngs_modulus": 70.0e9,
        "poisson_ratio": 0.33,
        "density": 2700.0,
        "thermal_expansion": 2.3e-5,
        "reference_temperature": 293.15,
        "conductivity": 167.0
      }
    }
  ],

  "model": { "stress_state": "plane_strain", "thickness": 0.02 },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    {
      "name": "conducted",
      // Steady conduction: the clamped end held at 100 C, a flux into the free
      // end, uniform generation in its last quarter and convection from the
      // top face; the solved temperature drives the thermal strain.
      "temperature": {
        "conduction": {
          "prescribed": [ { "name": "root", "value": 373.15, "region": { "box": { "xmax": 0.0 } } } ],
          "flux": [ { "name": "end", "value": 1.0e4, "region": { "box": { "xmin": 0.2 } } } ],
          "sources": [ { "name": "heater", "value": 2.0e5, "region": { "box": { "xmin": 0.15 } } } ],
          "convection": [ { "name": "top", "film_coefficient": 25.0, "ambient": 293.15,
                            "region": { "box": { "ymin": 0.1 } } } ]
        }
      }
    },
    {
      "name": "uniform",
      "temperature": { "uniform": 343.15 }
    },
    {
      "name": "hot_end",
      "temperature": {
        "uniform": 293.15,
        "regions": [ { "name": "end", "value": 393.15, "region": { "box": { "xmin": 0.15 } } } ]
      },
      "gravity": [0.0, -9.81]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 }
  },

  "modal": { "enabled": false },

  "output": { "csv": true, "vtk": true }
}
