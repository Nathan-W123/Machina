{
  // ---------------------------------------------------------------------------
  // Cross-validation of small-strain J2 plasticity on Tet10 (C3D10) elements:
  // an aluminium block 0.1 m x 0.1 m x 0.05 m (E = 70 GPa, nu = 0.33, yield
  // stress 200 MPa, linear isotropic hardening 0.7 GPa) resting on a rigid
  // base (u = 0 at z = 0) and indented by a flat punch - the middle
  // 0.05 m x 0.05 m of its top face driven down by 0.4 mm - which is then
  // partly withdrawn (load path 1 -> 0.4): a plastic zone under the punch,
  // and elastic unloading. CalculiX solves the same discrete problem with
  // *PLASTIC (C3D10, its four-point rule is SparLab's), scikit-fem with an
  // independent J2 implementation. No mean dilatation.
  // ---------------------------------------------------------------------------
  "name": "plastic_punch_tet10_small_strain",
  "description": "Aluminium block indented by a flat punch and partly relieved, Tet10 (C3D10) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_tet", "nx": 4, "ny": 4, "nz": 2, "lx": 0.1, "ly": 0.1, "lz": 0.05, "order": 2 },

  "material": {
    "name": "aluminium",
    "youngs_modulus": 70.0e9,
    "poisson_ratio": 0.33,
    "density": 2700.0,
    "plasticity": { "yield_stress": 200.0e6, "hardening_modulus": 0.7e9 }
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "base", "fix": ["x", "y", "z"], "region": { "box": { "zmax": 0.0 } } },
    { "name": "punch", "fix": ["x", "y", "z"], "value": [0.0, 0.0, -4.0e-4],
      "region": { "box": { "xmin": 0.025, "xmax": 0.075, "ymin": 0.025, "ymax": 0.075, "zmin": 0.05 } } }
  ],

  "load_cases": [
    { "name": "indent", "prescribed_displacement_only": true }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "small_strain",
    "mean_dilatation": "none",
    "steps": 8,
    "load_path": [1.0, 0.4],
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "punch_force_z", "component": "z", "quantity": "reaction",
        "region": { "box": { "xmin": 0.025, "xmax": 0.075, "ymin": 0.025, "ymax": 0.075, "zmin": 0.05 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
