{
  // ---------------------------------------------------------------------------
  // Cross-validation of the compressible neo-Hookean law at large strain on
  // Tet10 elements: a rubber-like block 0.2 m x 0.05 m x 0.05 m (E = 3 MPa,
  // nu = 0.45, rho = 1100 kg/m^3) clamped at x = 0, its tip face driven down
  // by 0.08 m under its self-weight - displacement control with a dead body
  // force, strains of order 20 %. CalculiX has no counterpart of this strain
  // energy (its NEO HOOKE splits it into an isochoric part and (J - 1)^2), so
  // the check is scikit-fem's independent total Lagrangian solve of the same
  // discrete problem; sparlab_verify --study hyperelastic-cylinder compares
  // the law with exact finite-strain solutions.
  // ---------------------------------------------------------------------------
  "name": "block_tet10_neohookean_nonlinear",
  "description": "Rubber-like block, neo-Hookean, tip driven under self-weight, Tet10 elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_tet", "nx": 8, "ny": 2, "nz": 2, "lx": 0.2, "ly": 0.05, "lz": 0.05, "order": 2 },

  "material": { "name": "rubber-like", "youngs_modulus": 3.0e6, "poisson_ratio": 0.45, "density": 1100.0 },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } },
    { "name": "driven_tip", "fix": ["z"], "value": [0.0, 0.0, -0.08], "region": { "box": { "xmin": 0.2 } } }
  ],

  "load_cases": [
    { "name": "driven_tip", "gravity": [0.0, 0.0, -9.81] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "material_model": "neo_hookean",
    "steps": 10,
    "residual_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_force_z", "component": "z", "quantity": "reaction", "region": { "box": { "xmin": 0.2 } } },
      { "name": "tip_x", "component": "x", "region": { "box": { "xmin": 0.2 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
