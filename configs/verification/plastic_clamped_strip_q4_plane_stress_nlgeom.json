{
  // ---------------------------------------------------------------------------
  // Cross-validation of finite-kinematics plasticity in plane stress on Q4
  // elements: the clamped strip of plastic_clamped_strip_q4_nlgeom in plane
  // stress (0.05 m thick; the same steel with isotropic, Voce and Prager
  // kinematic hardening), its mid-span section driven 20 mm down into
  // membrane action and back up to zero (load path 1 -> 0). Every point finds
  // its thickness strain by Newton in the Green-strain return (S_33 = 0), and
  // the Cauchy stress takes the thickness stretch sqrt(1 + 2 E_33). Plane
  // stress has no mean dilatation. Its judged comparison is with an
  // independent finite-kinematics J2 implementation in scikit-fem - its
  // plane-stress return solves S_33 = 0 by Newton with a central-difference
  // derivative; CalculiX gets no plastic deck (its HARDENING=KINEMATIC does
  // not reproduce Prager's rule, and its CPS4 is a layer of solids) -
  // python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "plastic_clamped_strip_q4_plane_stress_nlgeom",
  "description": "Clamped plane-stress strip driven past yield into membrane action and back, finite kinematics, combined hardening, Q4 (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_quad", "nx": 40, "ny": 4, "lx": 1.0, "ly": 0.05 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "plasticity": {
      "yield_stress": 250.0e6,
      "hardening_modulus": 1.0e9,
      "saturation_stress": 60.0e6,
      "saturation_rate": 30.0,
      "kinematic_hardening_modulus": 2.0e9
    }
  },

  "model": { "thickness": 0.05, "stress_state": "plane_stress" },

  "boundary_conditions": [
    { "name": "clamped_left", "fix": ["x", "y"], "region": { "box": { "xmax": 0.0 } } },
    { "name": "clamped_right", "fix": ["x", "y"], "region": { "box": { "xmin": 1.0 } } },
    { "name": "driven_mid_span", "fix": ["y"], "value": [0.0, -2.0e-2],
      "region": { "box": { "xmin": 0.5, "xmax": 0.5 } } }
  ],

  "load_cases": [
    { "name": "drive", "prescribed_displacement_only": true }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "finite",
    "steps": 10,
    "load_path": [1.0, 0.0],
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "mid_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmin": 0.5, "xmax": 0.5 } } },
      { "name": "end_force_x", "component": "x", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
