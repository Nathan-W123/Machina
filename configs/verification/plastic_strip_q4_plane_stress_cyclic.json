{
  // ---------------------------------------------------------------------------
  // Cross-validation of plane-stress J2 plasticity (the thickness strain
  // solved at every point so that sigma_zz = 0) on Q4 elements: an aluminium
  // strip 0.5 m x 0.05 m (0.01 m thick; E = 70 GPa, nu = 0.33, yield stress
  // 200 MPa, kinematic hardening 5 GPa and a Voce saturation of 50 MPa at rate
  // 40) whose tip is driven to u_y = -16 mm and back to +16 mm (load path
  // 1 -> -1). Compared with an independent J2 implementation in scikit-fem;
  // CalculiX's CPS4 is a 3-D layer, not plane stress, and its kinematic
  // hardening does not reproduce Prager's rule, so it gets no deck.
  // ---------------------------------------------------------------------------
  "name": "plastic_strip_q4_plane_stress_cyclic",
  "description": "Plane-stress strip cycled through reversed plasticity, kinematic and Voce hardening, Q4 (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_quad", "nx": 40, "ny": 6, "lx": 0.5, "ly": 0.05 },

  "material": {
    "name": "aluminium",
    "youngs_modulus": 70.0e9,
    "poisson_ratio": 0.33,
    "density": 2700.0,
    "plasticity": {
      "yield_stress": 200.0e6,
      "kinematic_hardening_modulus": 5.0e9,
      "saturation_stress": 50.0e6,
      "saturation_rate": 40.0
    }
  },

  "model": { "thickness": 0.01, "stress_state": "plane_stress" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y"], "region": { "box": { "xmax": 0.0 } } },
    { "name": "driven_tip", "fix": ["y"], "value": [0.0, -1.6e-2], "region": { "box": { "xmin": 0.5 } } }
  ],

  "load_cases": [
    { "name": "cycle", "prescribed_displacement_only": true }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "small_strain",
    "steps": 10,
    "load_path": [1.0, -1.0],
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmin": 0.5 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
