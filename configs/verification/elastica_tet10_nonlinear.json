{
  // ---------------------------------------------------------------------------
  // Cross-validation of the geometrically non-linear analysis on Tet10 (C3D10)
  // elements: Euler's elastica. A cantilever L = 1 m of square section
  // h = 0.02 m (E = 210 GPa, nu = 0) clamped at x = 0 under a dead shear
  // traction on its tip face whose resultant P = 28 kN gives
  // k = P L^2 / (E I) = 10: the tip deflects 0.81 L and turns 1.43 rad, where
  // the linear analysis predicts 3.3 L. sparlab_verify --study elastica
  // compares such cantilevers with the exact elastica; here the same discrete
  // problem is solved by CalculiX (*STEP, NLGEOM) and by an independent total
  // Lagrangian implementation in scikit-fem (python/scripts/cross_validate.py).
  // L/h = 50 rather than the study's 100: the round-off of a slender beam's
  // linear solve grows as (L/h)^3, and at 100 it left the linear comparison
  // with scikit-fem at 6.6e-8 against its 1e-7 tolerance (8.0e-9 at 50).
  // ---------------------------------------------------------------------------
  "name": "elastica_tet10_nonlinear",
  "description": "Large-deflection cantilever (the elastica at k = 10) on Tet10 (C3D10) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_tet", "nx": 24, "ny": 2, "nz": 2, "lx": 1.0, "ly": 0.02, "lz": 0.02, "order": 2 },

  "material": { "name": "steel", "youngs_modulus": 210.0e9, "poisson_ratio": 0.0, "density": 7850.0 },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    {
      "name": "tip_force",
      "tractions": [
        { "name": "tip_face", "traction": [0.0, -7.0e7, 0.0], "region": { "box": { "xmin": 1.0 } } }
      ]
    }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "material_model": "saint_venant_kirchhoff",
    "method": "load_control",
    "steps": 10,
    "residual_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_deflection", "component": "y", "region": { "box": { "xmin": 1.0 } } },
      { "name": "tip_shortening", "component": "x", "region": { "box": { "xmin": 1.0 } } },
      { "name": "root_force", "component": "y", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
