{
  // ---------------------------------------------------------------------------
  // Cross-validation of small-strain J2 plasticity with combined hardening and
  // mean dilatation on Hex8 elements: a steel cantilever 0.5 m x 0.05 m x
  // 0.05 m (E = 200 GPa, nu = 0.3, yield stress 250 MPa; isotropic hardening
  // 1 GPa plus a Voce saturation of 80 MPa at rate 25, Prager kinematic
  // hardening 3 GPa) whose tip face is driven through a displacement cycle,
  // u_y = -6 mm -> +6 mm -> -3 mm (load path 1 -> -1 -> 0.5): reversed
  // plasticity, the Bauschinger effect and the saturation, with B-bar. Its
  // comparison is with an independent J2 implementation in scikit-fem;
  // CalculiX gets no deck (its HARDENING=KINEMATIC does not reproduce
  // Prager's rule) - python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "plastic_beam_hex_cyclic",
  "description": "Steel cantilever tip cycled through reversed plasticity, combined hardening, Hex8 with B-bar (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_hex", "nx": 20, "ny": 4, "nz": 2, "lx": 0.5, "ly": 0.05, "lz": 0.05 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "plasticity": {
      "yield_stress": 250.0e6,
      "hardening_modulus": 1.0e9,
      "saturation_stress": 80.0e6,
      "saturation_rate": 25.0,
      "kinematic_hardening_modulus": 3.0e9
    }
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } },
    { "name": "driven_tip", "fix": ["y"], "value": [0.0, -6.0e-3, 0.0], "region": { "box": { "xmin": 0.5 } } }
  ],

  "load_cases": [
    { "name": "cycle", "prescribed_displacement_only": true }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "small_strain",
    "steps": 8,
    "load_path": [1.0, -1.0, 0.5],
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmin": 0.5 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
