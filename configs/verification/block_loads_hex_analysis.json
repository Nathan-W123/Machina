{
  // ---------------------------------------------------------------------------
  // Cross-validation of the volume and pressure loads on Hex8 (C3D8) elements: a
  // 0.4 m x 0.1 m x 0.1 m steel block clamped at x = 0 under self-weight, a
  // pressure on its top face, a rotation about an axis through its root, a body
  // force density on its outer half, and all of them combined with a point
  // load. The CalculiX export writes each load in CalculiX's own form (GRAV,
  // P faces, CENTRIF, BY on an element set) so that CalculiX integrates it
  // itself; python/scripts/cross_validate.py compares the displacements.
  // ---------------------------------------------------------------------------
  "name": "block_loads_hex_analysis",
  "description": "Self-weight, pressure, rotation and body force on Hex8 (C3D8) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_hex", "nx": 20, "ny": 5, "nz": 5, "lx": 0.4, "ly": 0.1, "lz": 0.1 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    {
      "name": "self_weight",
      "gravity": [0.0, 0.0, -9.81]
    },
    {
      "name": "pressure",
      "pressures": [
        { "name": "top", "pressure": 1.0e6, "region": { "box": { "zmin": 0.1 } } }
      ]
    },
    {
      "name": "spin",
      // A rotor blade: rotation about the z axis through the middle of the root.
      "centrifugal": { "angular_velocity": 300.0, "axis": [0.0, 0.0, 1.0], "point": [0.0, 0.05, 0.0] }
    },
    {
      "name": "body_force",
      "body_forces": [
        { "name": "outer_half", "force_density": [0.0, 2.0e5, 0.0], "region": { "box": { "xmin": 0.2 } } }
      ]
    },
    {
      "name": "combined",
      // Self-weight, a pressure on the free end and a point load together:
      // the CalculiX deck mixes *CLOAD with *DLOAD cards.
      "gravity": [0.0, -9.81, 0.0],
      "pressures": [
        { "name": "end", "pressure": 5.0e5, "region": { "box": { "xmin": 0.4 } } }
      ],
      "point_loads": [
        { "name": "tip_corner", "force": [0.0, 0.0, -500.0], "distribution": "total",
          "region": { "nearest_node": [0.4, 0.1, 0.1] } }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 }
  },

  "modal": { "enabled": false },

  "output": { "csv": true, "vtk": true }
}
