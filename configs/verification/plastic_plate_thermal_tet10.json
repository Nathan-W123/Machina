{
  // ---------------------------------------------------------------------------
  // Cross-validation of thermal plasticity on Tet10 (C3D10) elements: a steel
  // plate 0.1 m x 0.1 m x 0.01 m (E = 200 GPa, nu = 0.3, alpha = 1.2e-5 /K,
  // yield stress 250 MPa, isotropic hardening 2 GPa) held at its rim, whose
  // middle is heated by 250 K - a restrained thermal stress of order
  // E alpha dT = 600 MPa, well past yield - and cooled back (load path
  // 1 -> 0), which leaves residual stresses and a permanent distortion.
  // CalculiX solves the same discrete problem with *PLASTIC, *EXPANSION and
  // the ramped nodal *TEMPERATURE of each step (C3D10 interpolates the
  // temperature at its points, as SparLab does); scikit-fem with an
  // independent J2 implementation whose thermal strain enters the return.
  // ---------------------------------------------------------------------------
  "name": "plastic_plate_thermal_tet10",
  "description": "Rim-held steel plate heated past yield in its middle and cooled back, Tet10 (C3D10) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, K)",

  "mesh": { "type": "structured_tet", "nx": 4, "ny": 4, "nz": 1, "lx": 0.1, "ly": 0.1, "lz": 0.01, "order": 2 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "thermal_expansion": 1.2e-5,
    "reference_temperature": 293.15,
    "plasticity": { "yield_stress": 250.0e6, "hardening_modulus": 2.0e9 }
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "rim_x0", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } },
    { "name": "rim_x1", "fix": ["x", "y", "z"], "region": { "box": { "xmin": 0.1 } } },
    { "name": "rim_y0", "fix": ["x", "y", "z"], "region": { "box": { "ymax": 0.0 } } },
    { "name": "rim_y1", "fix": ["x", "y", "z"], "region": { "box": { "ymin": 0.1 } } }
  ],

  "load_cases": [
    {
      "name": "heat_cool",
      "temperature": {
        "uniform": 293.15,
        "regions": [ { "name": "hot_middle", "value": 543.15,
                       "region": { "box": { "xmin": 0.025, "xmax": 0.075, "ymin": 0.025, "ymax": 0.075 } } } ]
      }
    }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "small_strain",
    "mean_dilatation": "none",
    "steps": 8,
    "load_path": [1.0, 0.0],
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "centre_z", "component": "z", "region": { "nearest_node": [0.05, 0.05, 0.01] } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
