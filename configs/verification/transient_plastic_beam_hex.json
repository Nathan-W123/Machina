{
  // ---------------------------------------------------------------------------
  // Cross-validation of the elastoplastic transient (small strain, J2 with
  // linear isotropic hardening) on Hex8 (C3D8; standard integration, as
  // CalculiX's, rather than the mean dilatation SparLab's Hex8 applies by
  // default): a steel cantilever 0.6 m x 0.06 m x 0.06 m, clamped, its tip
  // load of 20 kN (4/3 of the load at which beam theory yields the root
  // fibre, sigma_y b h^2 / (6 L) = 15 kN) ramped up as sin^2 over 6 ms and
  // held: the tip overshoots to 1.5 times its linear static deflection, the root
  // yields to a plastic strain of 1.0e-3, the plastic flow dissipating 26 J
  // (measured). Rayleigh damping C = 30 M, 200 steps of 0.2 ms with the
  // trapezoidal rule. Compared with
  // CalculiX's *DYNAMIC, DIRECT with *PLASTIC and with an independent J2
  // implementation integrated by HHT-alpha in scikit-fem -
  // python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "transient_plastic_beam_hex",
  "description": "Hex8 cantilever loaded dynamically past yield, small-strain J2, trapezoidal rule (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, s)",

  "mesh": { "type": "structured_hex", "nx": 20, "ny": 3, "nz": 2, "lx": 0.6, "ly": 0.06, "lz": 0.06 },

  "material": {
    "name": "steel", "youngs_modulus": 200.0e9, "poisson_ratio": 0.3, "density": 7850.0,
    "plasticity": { "yield_stress": 250.0e6, "hardening_modulus": 2.0e9 }
  },

  "boundary_conditions": [
    { "name": "clamped", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "tip", "point_loads": [
        { "name": "tip_face", "force": [0.0, -20000.0, 0.0], "distribution": "total",
          "region": { "box": { "xmin": 0.6 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "transient": {
    "enabled": true,
    "time_step": 2.0e-4,
    "end_time": 4.0e-2,
    "alpha": 0.0,
    "mass": "consistent",
    "damping": { "mass": 30.0 },
    "amplitude": { "type": "table", "times": [0, 0.00020000000000000001, 0.00040000000000000002, 0.00060000000000000006, 0.00080000000000000004, 0.001, 0.0012000000000000001, 0.0014, 0.0016000000000000001, 0.0018000000000000002, 0.002, 0.0022000000000000001, 0.0024000000000000002, 0.0026000000000000003, 0.0028, 0.0030000000000000001, 0.0032000000000000002, 0.0034000000000000002, 0.0036000000000000003, 0.0038, 0.0040000000000000001, 0.0042000000000000006, 0.0044000000000000003, 0.0045999999999999999, 0.0048000000000000004, 0.0050000000000000001, 0.0052000000000000006, 0.0054000000000000003, 0.0055999999999999999, 0.0058000000000000005, 0.0060000000000000001],
                   "values": [0, 0.0027390523158633312, 0.010926199633097178, 0.024471741852423214, 0.043227271178699546, 0.066987298107780688, 0.095491502812526274, 0.12842758726130288, 0.16543469682057085, 0.20610737385376346, 0.25, 0.29663167846209992, 0.34549150281252627, 0.39604415459112041, 0.44773576836617329, 0.49999999999999989, 0.55226423163382654, 0.6039558454088797, 0.65450849718747373, 0.70336832153789997, 0.75000000000000011, 0.79389262614623668, 0.83456530317942901, 0.87157241273869712, 0.90450849718747361, 0.93301270189221941, 0.9567727288213006, 0.97552825814757682, 0.98907380036690273, 0.99726094768413653, 1] },
    "snapshot_every": 20,
    "nonlinear": true,
    "kinematics": "small_strain",
    "mean_dilatation": false,
    "residual_tolerance": 1.0e-10,
    "displacement_tolerance": 1.0e-10,
    "monitors": [
      { "name": "tip_uy", "component": "y", "region": { "box": { "xmin": 0.6 } } },
      { "name": "root_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
