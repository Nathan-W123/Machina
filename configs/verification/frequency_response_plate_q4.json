{
  // ---------------------------------------------------------------------------
  // Cross-validation of the harmonic response on Q4 in plane stress: the
  // steel cantilever plate 1 m x 0.1 m (0.01 m thick) of the solve tests, a
  // tip force of 100 N in y, swept on a log scale from 10 Hz to 3 kHz (120
  // frequencies, through its first four bending modes) with structural
  // damping eta = 0.02 plus C = 2 M + 1e-6 K, the complex fields at 80, 500
  // and 1300 Hz. Compared with a direct complex solve per frequency in
  // scikit-fem; CalculiX's *STEADY STATE DYNAMICS is a modal superposition,
  // not a direct solve, and is not used - python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "frequency_response_plate_q4",
  "description": "Q4 cantilever plate, harmonic tip force swept through four resonances (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, s)",

  "mesh": { "type": "structured_quad", "nx": 40, "ny": 4, "lx": 1.0, "ly": 0.1 },

  "material": { "name": "steel", "youngs_modulus": 200.0e9, "poisson_ratio": 0.3, "density": 7850.0 },

  "model": { "thickness": 0.01, "stress_state": "plane_stress" },

  "boundary_conditions": [
    { "name": "clamped", "fix": ["x", "y"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "tip", "point_loads": [
        { "name": "tip_edge", "force": [0.0, -100.0], "distribution": "total",
          "region": { "box": { "xmin": 1.0 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "frequency_response": {
    "enabled": true,
    "frequencies": { "start": 10.0, "end": 3000.0, "count": 120, "spacing": "log" },
    "mass": "consistent",
    "damping": { "structural": 0.02, "mass": 2.0, "stiffness": 1.0e-6 },
    "snapshot_frequencies": [80.0, 500.0, 1300.0],
    "monitors": [
      { "name": "tip_uy", "component": "y", "region": { "box": { "xmin": 1.0 } } },
      { "name": "tip_ay", "component": "y", "quantity": "acceleration", "region": { "box": { "xmin": 1.0 } } },
      { "name": "root_force_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
