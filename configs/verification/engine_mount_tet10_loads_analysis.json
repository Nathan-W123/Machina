{
  // ---------------------------------------------------------------------------
  // The curved-Tet10 engine mount of engine_mount_tet10_analysis.json (13 918
  // C3D10 cells from Gmsh, edge nodes on the curved holes) under the loads of
  // the physics expansion: a pressure on the curved pin bore, self-weight, a
  // rotation, and a conducted temperature field with its thermal stress. The
  // bolt holes are clamped.
  //
  // Used by scripts/run_cross_validation.sh: CalculiX integrates each load
  // itself from the exported deck (P faces on the curved six-node faces,
  // GRAV, CENTRIF, *TEMPERATURE with *EXPANSION) and solves the conduction
  // problem itself (*HEAT TRANSFER on DC3D10 cells); scikit-fem integrates
  // the same loads on an isoparametric MeshTet2.
  // ---------------------------------------------------------------------------
  "name": "engine_mount_tet10_loads_analysis",
  "description": "Pressure, self-weight, rotation and conduction on the curved Tet10 engine mount (cross-validation deck)",
  "units": "SI (m, N, Pa, kg, K, W)",

  "mesh": {
    "type": "file",
    "path": "../meshes/engine_mount_3d_tet10.inp",
    "scale": 0.001
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0,
    "thermal_expansion": 2.34e-5,
    "reference_temperature": 293.15,
    "conductivity": 130.0
  },

  "boundary_conditions": [
    { "name": "bolts", "fix": ["x", "y", "z"], "region": { "group": "bolt_holes" } }
  ],

  "load_cases": [
    {
      "name": "bore_pressure",
      "pressures": [ { "name": "pin", "pressure": 20.0e6, "region": { "group": "pin_hole" } } ]
    },
    {
      "name": "self_weight",
      "gravity": [0.0, 0.0, -9.81]
    },
    {
      "name": "spin",
      "centrifugal": { "angular_velocity": 800.0, "axis": [0.0, 0.0, 1.0], "point": [0.0, 0.0, 0.0] }
    },
    {
      "name": "conducted",
      // The pin bore at 120 C, the bolt holes at 20 C, and every face
      // convecting to 20 C air.
      "temperature": {
        "conduction": {
          "prescribed": [
            { "name": "pin", "value": 393.15, "region": { "group": "pin_hole" } },
            { "name": "bolts", "value": 293.15, "region": { "group": "bolt_holes" } }
          ],
          "convection": [
            { "name": "air", "film_coefficient": 20.0, "ambient": 293.15, "region": { "all": true } }
          ]
        }
      }
    }
  ],

  "solver": {
    "linear": { "type": "auto", "iterative_tolerance": 1e-11, "residual_tolerance": 1e-8 }
  },

  "modal": { "enabled": false },

  "output": { "csv": true, "vtk": true }
}
