{
  // ---------------------------------------------------------------------------
  // Cross-validation of small-strain J2 plasticity on Hex8 (C3D8) elements: a
  // steel cantilever 0.5 m x 0.05 m x 0.05 m (E = 200 GPa, nu = 0.3, yield
  // stress 250 MPa, linear isotropic hardening 2 GPa) clamped at x = 0, loaded
  // by a tip force of 15 kN - 1.44 times the elastic limit of beam theory,
  // 0.96 of its plastic collapse load, which the fully integrated Hex8's
  // bending stiffness (shear locking) keeps well short of collapse - and
  // unloaded again (load path 1 -> 0), leaving a permanent set. No mean dilatation, so that CalculiX's C3D8 (full
  // integration) solves the same discrete problem with *PLASTIC and the same
  // fixed increments; scikit-fem solves it with an independent J2
  // implementation - python/scripts/cross_validate.py.
  // ---------------------------------------------------------------------------
  "name": "plastic_beam_hex_small_strain",
  "description": "Steel cantilever loaded into the plastic range and unloaded, Hex8 (C3D8) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_hex", "nx": 30, "ny": 6, "nz": 2, "lx": 0.5, "ly": 0.05, "lz": 0.05 },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0,
    "plasticity": { "yield_stress": 250.0e6, "hardening_modulus": 2.0e9 }
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    { "name": "tip", "point_loads": [ { "name": "tip", "force": [0.0, -15000.0, 0.0], "region": { "box": { "xmin": 0.5 } } } ] }
  ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "small_strain",
    "mean_dilatation": "none",
    "steps": 8,
    "load_path": [1.0, 0.0],
    "residual_tolerance": 1e-10,
    "displacement_tolerance": 1e-10,
    "monitors": [
      { "name": "tip_y", "component": "y", "region": { "box": { "xmin": 0.5 } } },
      { "name": "root_reaction_y", "component": "y", "quantity": "reaction", "region": { "box": { "xmax": 0.0 } } }
    ]
  },

  "output": { "csv": true, "vtk": true }
}
